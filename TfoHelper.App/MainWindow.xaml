<Window x:Class="TfoHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Toad for Oracle Helper" Height="600" Width="800">
    <Grid>
        <Grid x:Name="WebViewContainer" />
        
        <Grid x:Name="StatusOverlay" Background="#CCFFFFFF" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Processing..." FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                <ProgressBar IsIndeterminate="True" Height="20" Width="200"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
